; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Craft to Nation"
run/main_scene="res://scenes/VideoIntro.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/minimum_display_time=0
boot_splash/bg_color=Color(0.043, 0.086, 0.071, 1)
config/icon="res://icon.png"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode="fullscreen"

[autoload]

Configuracion="*res://scripts/Configuracion.gd"
GestorPartida="*res://scripts/GestorPartida.gd"
Ciudad="*res://scripts/Ciudad.gd"
Zonificacion="*res://scripts/Zonificacion.gd"
Recoleccion="*res://scripts/Recoleccion.gd"
Economia="*res://scripts/Economia.gd"
Blueprints="*res://scripts/Blueprints.gd"
Construccion="*res://scripts/Construccion.gd"
CadenaMinerales="*res://scripts/CadenaMinerales.gd"
Obras="*res://scripts/Obras.gd"
Colonos="*res://scripts/Colonos.gd"
Vias="*res://scripts/Vias.gd"
Canalizaciones="*res://scripts/Canalizaciones.gd"
Sonidos="*res://scripts/Sonidos.gd"

[physics]

3d/physics_engine="GodotPhysics3D"
